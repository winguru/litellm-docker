# .env.example — copy to .env and fill in real values.
#
# .env is gitignored and never committed. It overrides the defaults from the
# committed stack.env. Only set what you actually need; anything left empty
# here stays at its stack.env default.
#
#   cp .env.example .env
#
# ── Core LiteLLM ────────────────────────────────────────────────────────────
# Master key for the LiteLLM proxy (sk-...). Generate e.g.:
#   openssl rand -hex 16  (prefix with "sk-")
LITELLM_MASTER_KEY="sk-change-me"
# Salt for token hashing. Generate: openssl rand -hex 32
LITELLM_SALT_KEY="change-me"
LITELLM_LOG="INFO"

# ── Infrastructure ───────────────────────────────────────────────────────────
REDIS_PASSWORD="change-me"

# ── Model providers ──────────────────────────────────────────────────────────
# Z.AI (GLM models + vision MCP)
ZAI_API_KEY="..."
# Voyage embeddings
VOYAGE_API_KEY="pa-..."
# CHUB AI
CHUBAI_API_KEY="CHK-..."
# NovelAI
NOVELAI_API_KEY="pst-..."
# Local LM Studio endpoint
LMSTUDIO_HOST="http://host.docker.internal:1234/v1"
LMSTUDIO_API_KEY="sk-lm-..."

# ── Langfuse tracing (optional) ──────────────────────────────────────────────
LANGFUSE_SECRET_KEY="sk-lf-..."
LANGFUSE_PUBLIC_KEY="pk-lf-..."
LANGFUSE_BASE_URL="https://us.cloud.langfuse.com"
LANGFUSE_OTEL_HOST="https://us.cloud.langfuse.com"

# ── Context7 MCP (optional) ─────────────────────────────────────────────────
# Free key at https://context7.com/dashboard for higher rate limits.
# Leave empty for anonymous access.
CONTEXT7_API_KEY=""

# ── Serena MCP (optional, opt-in via Compose profile) ───────────────────────
# For live local code, run Serena locally over stdio instead — see README
# "Serena: local vs. remote". This remote instance targets PUSHED repos,
# cloned into a Docker volume by the serena-projects-init service (no bind
# mounts needed — works when the stack runs on a different machine).
#
# Enable the remote Serena containers (serena-mcp + serena-projects-init):
#   COMPOSE_PROFILES=serena
# Portainer reads this variable from stack.env too.
#COMPOSE_PROFILES="serena"
#
# Space-separated git URLs for the codebases Serena should work on,
# optionally pinned to a branch with "<url>|<branch>". Cloned into a Docker
# volume by the serena-projects-init service (no bind mounts needed — works
# when the stack runs on a different machine than your code).
# SERENA_GIT_REPOS="https://github.com/your-org/repo.git https://github.com/your-org/other.git|develop"
# GitHub PAT for private repositories (optional)
# SERENA_GIT_TOKEN=""
# Repo name (or in-container path) to activate at startup (optional)
# SERENA_ACTIVE_PROJECT="repo"
# "true" to discard local edits in the projects volume on each restart
# SERENA_GIT_RESET="false"

# ── PGVector (optional, see docker-compose.pgvector.yml) ────────────────────
# PGVECTOR_DATABASE_URL="postgresql://llmproxy:dbpassword9090@pgvector-db:5432/litellm_vector?schema=public"
# PGVECTOR_SERVER_API_KEY="replace-with-a-long-random-secret"
# PGVECTOR_BASE_URL="http://pgvector:8000"
# EMBEDDING__MODEL="text-embedding-3-small"
# EMBEDDING__BASE_URL="http://litellm:4000"
# EMBEDDING__API_KEY="sk-1234"
# EMBEDDING__DIMENSIONS="1536"
