# stack.env file for Portainer.io
LITELLM_LOG="INFO"
REDIS_PASSWORD="another_strong_password"
LANGFUSE_SECRET_KEY="sk-lf-..."
LANGFUSE_PUBLIC_KEY="pk-lf-..."
LANGFUSE_BASE_URL="https://us.cloud.langfuse.com"
LANGFUSE_OTEL_HOST="https://us.cloud.langfuse.com"
ZAI_API_KEY="..."
VOYAGE_API_KEY="pa-..."
CHUBAI_API_KEY="CHK-..."
NOVELAI_API_KEY="pst-..."
LMSTUDIO_HOST="http://host.docker.internal:1234/v1"
LMSTUDIO_API_KEY="sk-lm-..."

# Optional PGVector runtime settings for future role-play / story retrieval
# Keep these in a separate database from the main LiteLLM DB.
# PGVECTOR_DATABASE_URL="postgresql://llmproxy:dbpassword9090@pgvector:5432/litellm_vector?schema=public"
# PGVECTOR_SERVER_API_KEY="replace-with-a-long-random-secret"
# These are LiteLLM embedding settings for the optional vector-store service.
# They are not the same as the LM Studio or local agent model endpoint.
# LITELLM_EMBEDDING__MODEL="text-embedding-3-small"  # or gemini-embedding-001, voyage-3-large, etc.
# LITELLM_EMBEDDING__BASE_URL="http://litellm:4000"
# LITELLM_EMBEDDING__API_KEY="sk-1234"
# LITELLM_EMBEDDING__DIMENSIONS="1536"
# OPENAI_API_KEY="sk-..."
# LOCAL_EMBEDDING_MODEL="sentence-transformers/all-MiniLM-L6-v2"
# LOCAL_EMBEDDING_BASE_URL="http://host.docker.internal:11434/v1"
# LOCAL_EMBEDDING_API_KEY="sk-local"
# DB_FIELDS__ID_FIELD="id"
# DB_FIELDS__CONTENT_FIELD="content"
# DB_FIELDS__METADATA_FIELD="metadata"
# DB_FIELDS__EMBEDDING_FIELD="embedding"
# DB_FIELDS__VECTOR_STORE_ID_FIELD="vector_store_id"
# DB_FIELDS__CREATED_AT_FIELD="created_at"